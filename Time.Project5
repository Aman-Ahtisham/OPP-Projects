class Time {
    int hr, min, seconds;

    public Time() {
        this.hr = 0;
        this.min = 0;
        this.seconds = 0;
    }

    public Time(int hr, int min, int seconds) {
        this.hr = (hr >= 0 && hr < 24) ? hr : 0;
        this.min = (min >= 0 && min < 60) ? min : 0;
        this.seconds = (seconds >= 0 && seconds < 60) ? seconds : 0;
    }

    public void display() {
        System.out.println(hr + " hr : " + min + " min : " + seconds + " sec");
    }

    public static void main(String[] args) {
        Time t1 = new Time(10, 45, 30);
        t1.display();
        Time t2 = new Time(25, 70, -5);
        t2.display();
    }
}
